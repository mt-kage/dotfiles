#!/usr/bin/env bash

# Bash-specific prompt configuration.

# Load shared prompt definitions (colors, prompt_git, styles).
source "${XDG_SHARED_CONFIG_HOME}/.prompt";

# Set the terminal title and prompt.
PS1="\n" # newline
PS1+="\[${bold}\]"
PS1+="\[${userStyle}\]\u"; # username
PS1+="\[${white}\]: ";
PS1+="\[${green}\]\w"; # working directory full path
PS1+="\$(prompt_git \"\[${white}\] [\[${violet}\]\" \"\[${blue}\]\"\[${white}\]])"; # Git repository details
PS1+="\n";
PS1+="\[${white}\]\$ \[${reset}\]"; # `$` (and reset color)
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
