#!/usr/bin/env zsh

# Zsh-specific prompt configuration.

# Load shared prompt definitions (colors, prompt_git, styles).
source "${XDG_SHARED_CONFIG_HOME}/.prompt";

# Enable prompt substitution
setopt PROMPT_SUBST;

# Set the terminal title and prompt.
# zsh uses %{ %} instead of \[ \] for non-printing characters
# %n = username, %~ = working directory, %# = $ or # based on privileges
PROMPT=$'\n' # newline
PROMPT+="%{${bold}%}"
PROMPT+="%{${userStyle}%}%n" # username
PROMPT+="%{${white}%}: "
PROMPT+="%{${green}%}%~" # working directory full path
PROMPT+='$(prompt_git "%{${white}%} [%{${violet}%}" "%{${blue}%}%{${white}%}]")' # Git repository details
PROMPT+=$'\n'
PROMPT+="%{${white}%}$ %{${reset}%}" # `$` (and reset color)

PROMPT2="%{${yellow}%}→ %{${reset}%}";
