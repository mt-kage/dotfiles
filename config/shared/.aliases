# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"

# Shortcuts
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias p="cd ~/Projects"
alias ss="cd ~/Pictures/Screenshots"
alias dtf="cd ~/dotfiles"

# Detect which `ls` flavor is in use
if ls --color > /dev/null 2>&1; then # GNU `ls`
	colorflag="--color"
	export LS_COLORS='no=00:fi=00:di=01;31:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'
else # macOS `ls`
	colorflag="-G"
	export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
fi

# List files
alias ls="command ls ${colorflag}"
alias ll="ls -lF ${colorflag}"
alias la="ls -laF ${colorflag}"

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# OS / WSL detection for aliases
_is_wsl=0
_is_macos=0
if [ "$(uname)" = "Darwin" ]; then
	_is_macos=1
elif [ "$(uname)" = "Linux" ]; then
	if [ -n "${WSL_DISTRO_NAME:-}" ] || [ -n "${WSL_INTEROP:-}" ] || uname -r | grep -qi 'microsoft' || { [ -f /proc/version ] && grep -qi 'microsoft' /proc/version; }; then
		_is_wsl=1
	fi
fi

# IP addresses
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
if [ "$_is_macos" -eq 1 ]; then
	alias localip="ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null"
	# Show/hide hidden files in Finder
	alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
	alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
else
	alias localip="hostname -I | awk '{print \$1}'"
fi

# WSL Interop (Windows Integration)
if [ "$_is_wsl" -eq 1 ]; then
	if type clip.exe >/dev/null 2>&1; then
		alias pbcopy="clip.exe"
	fi
	if type powershell.exe >/dev/null 2>&1; then
		alias pbpaste="powershell.exe -NoProfile -Command Get-Clipboard 2>/dev/null | tr -d '\r'"
	fi
	if type wslview >/dev/null 2>&1; then
		alias open="wslview"
	elif type explorer.exe >/dev/null 2>&1; then
		alias open="explorer.exe"
	fi
fi

unset _is_wsl _is_macos

# Reload the shell (i.e. invoke as a login shell)
alias reload="exec $SHELL -l"

# Print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

# Generate SSH Keys.
alias ssh-keygen="ssh-keygen -t rsa -b 4096"

# Git
alias brname="git symbolic-ref --short HEAD"

# Dotfiles
alias dot-update="(cd ~/dotfiles && bash scripts/update.sh)"
